# Server (use 5000 if free; 5001 avoids clash with other local projects)
PORT=5001
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sail_vrs

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS (frontend origin)
CLIENT_ORIGIN=http://localhost:5173
